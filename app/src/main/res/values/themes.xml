<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme applied to the window before Compose sets its own MaterialTheme.
         NoActionBar because the app draws its own top bars. -->
    <style name="Theme.StethoScope" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/teal_700</item>
    </style>

    <!--
        Launch theme — what the phone paints BEFORE the app has drawn anything.

        Android shows a "starting window" built from the activity's theme the moment the
        launcher icon is tapped, long before Compose produces its first frame. With the
        normal theme that window was @color/window_background (near-white), which is the
        blank flash that used to appear ahead of the teal FullerScope splash. Matching it
        to the splash's own background means the app comes up teal immediately and the
        logo, name and progress bar simply paint into a screen that is already the right
        colour.

        This is deliberately a SEPARATE theme rather than a change to the one above:
        windowBackground also sits behind every ordinary screen, so making the app theme
        teal would show a teal flash on any activity recreation (the language switcher
        calls recreate()) and behind any screen that did not paint every pixel.
        MainActivity swaps back to Theme.StethoScope before the first frame — see
        MainActivity.onCreate.

        @color/teal_500 is the same value as MaterialTheme.colorScheme.primary
        (Color.kt's Teal500, #00838F), which is what SplashScreen fills its Surface with.
        If one changes, change the other.
    -->
    <style name="Theme.StethoScope.Launch" parent="Theme.StethoScope">
        <item name="android:windowBackground">@color/teal_500</item>
    </style>
</resources>
